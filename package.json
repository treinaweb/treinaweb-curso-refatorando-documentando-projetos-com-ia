{
  "name": "loja-api",
  "version": "1.0.0",
  "description": "API de pedidos da loja",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "ISC",
  "dependencies": {
    "express": "5.3.0",
    "sqlite3": "5.1.7",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
